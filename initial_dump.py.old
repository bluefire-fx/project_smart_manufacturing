# %%
from sklearn.metrics import classification_report, mean_absolute_error, r2_score
from sklearn.model_selection import train_test_split
from sklearn.svm import SVC, SVR

# 1. Gemeinsame Eingangsfeatures (NUR die 5 reinen physikalischen Sensoren)
pure_sensors = [
    "energy_consumption",
    "pressure",
    "humidity",
    "vibration",
    "temperature",
]
X = df_prep[pure_sensors]

# 2. Die beiden getrennten Zielvariablen definieren
y_clf = df_prep["anomaly_flag"]
y_reg = df_prep["predicted_remaining_life"]

# Wir nutzen ein schnelles 20k Sample für das Training im Jupyter Notebook
X_sample = X.sample(n=40000, random_state=42)
y_clf_sample = y_clf.loc[X_sample.index]
y_reg_sample = y_reg.loc[X_sample.index]

# -------------------------------------------------------------------------
# MODELL 1: KLASSIFIKATION (Anomaly Flag)
# -------------------------------------------------------------------------
X_train_c, X_test_c, y_train_c, y_test_c = train_test_split(
    X_sample, y_clf_sample, test_size=0.2, random_state=42, stratify=y_clf_sample
)

svm_clf = SVC(
    kernel="rbf",
    class_weight="balanced",
    probability=True,
    cache_size=2000,
    random_state=42,
)
print("1. Trainiere RBF-SVC für Anomalie-Erkennung...")
svm_clf.fit(X_train_c, y_train_c)
y_pred_c = svm_clf.predict(X_test_c)

# -------------------------------------------------------------------------
# MODELL 2: REGRESSION (Predicted Remaining Life)
# -------------------------------------------------------------------------
# Hinweis: Bei Regression kein 'stratify', da es sich um kontinuierliche Werte handelt
X_train_r, X_test_r, y_train_r, y_test_r = train_test_split(
    X_sample, y_reg_sample, test_size=0.2, random_state=42
)

# SVR benötigt kein class_weight, da es keine Klassen gibt
svm_reg = SVR(kernel="rbf", cache_size=2000)
print("2. Trainiere RBF-SVR für Lebensdauer-Regression...")
svm_reg.fit(X_train_r, y_train_r)
y_pred_r = svm_reg.predict(X_test_r)

# -------------------------------------------------------------------------
# AUSWERTUNG BEIDER MODELLE
# -------------------------------------------------------------------------
print("\n=========================================================")
print("🚀 ERGEBNISSE MODELL 1: ANOMALIE-KLASSIFIKATION (SVC)")
print("=========================================================")
print(classification_report(y_test_c, y_pred_c))

print("\n=========================================================")
print("📈 ERGEBNISSE MODELL 2: LEBENSDAUER-REGRESSION (SVR)")
print("=========================================================")
# Da wir y vorhin skaliert haben, spuckt der MAE den Fehler in Standardabweichungen aus
mae = mean_absolute_error(y_test_r, y_pred_r)
r2 = r2_score(y_test_r, y_pred_r)
print(f"Mean Absolute Error (MAE): {mae:.4f} (Standardabweichungen)")
print(f"Bestimmtheitsmaß (R²-Score): {r2:.4f}")
# %%

# 1. Erweitere die Features für die Regression um die Zeittrends
regression_features = [
    "energy_consumption",
    "pressure",
    "humidity",
    "vibration",
    "temperature",
    "temperature_roll_mean",
    "temperature_roll_std",
    "vibration_roll_mean",
    "vibration_roll_std",
    "pressure_roll_mean",
    "pressure_roll_std",
]

# Hinweis: Stelle sicher, dass diese _roll_ Spalten im df_prep existieren
# und durch den StandardScaler gelaufen sind!
X_reg_extended = df_prep[regression_features].sample(n=40000, random_state=42)
y_reg_extended = df_prep["predicted_remaining_life"].loc[X_reg_extended.index]

# 2. Neuer Split für die Regression
X_train_re, X_test_re, y_train_re, y_test_re = train_test_split(
    X_reg_extended, y_reg_extended, test_size=0.2, random_state=42
)

# 3. Trainiere die SVR neu (mit etwas mehr RAM-Cache für die 11 Features)
svm_reg_extended = SVR(kernel="rbf", cache_size=2000)
print("Trainiere optimierte RBF-SVR mit historischen Zeittrends...")
svm_reg_extended.fit(X_train_re, y_train_re)

# 4. Auswertung
y_pred_re = svm_reg_extended.predict(X_test_re)
print("\n--- 📈 NEUE ERGEBNISSE: OPTIMIERTE LEBENSDAUER-REGRESSION (SVR) ---")
print(f"Mean Absolute Error (MAE): {mean_absolute_error(y_test_re, y_pred_re):.4f}")
print(f"Bestimmtheitsmaß (R²-Score): {r2_score(y_test_re, y_pred_re):.4f}")

# %%

import numpy as np
from sklearn.metrics import mean_absolute_error, r2_score
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVR

# 1. Frische Kopie für das Regressions-Experiment erstellen
df_reg_experiment = df_trends.copy()

# 2. Alle Features definieren, die wir nutzen wollen (Basis + Trends)
regression_features = [
    "energy_consumption",
    "pressure",
    "humidity",
    "vibration",
    "temperature",
    "temperature_roll_mean",
    "temperature_roll_std",
    "vibration_roll_mean",
    "vibration_roll_std",
    "pressure_roll_mean",
    "pressure_roll_std",
]

# 3. WICHTIG: Die rollierenden Features müssen VOR dem Training standardisiert werden
scaler_reg = StandardScaler()
df_reg_experiment[regression_features] = scaler_reg.fit_transform(
    df_reg_experiment[regression_features]
)

# 4. Ziehe das identische 20k Sample (wichtig für den Vergleich zum ersten Versuch)
X_reg_extended = df_reg_experiment[regression_features].sample(n=20000, random_state=42)
y_reg_extended = df_reg_experiment["predicted_remaining_life"].loc[X_reg_extended.index]

# 5. Train-Test-Split (80% / 20%)
X_train_re, X_test_re, y_train_re, y_test_re = train_test_split(
    X_reg_extended, y_reg_extended, test_size=0.2, random_state=42
)

# 6. SVR trainieren (RBF-Kernel mit erhöhtem Cache)
svm_reg_extended = SVR(kernel="rbf", cache_size=2000)
print("Trainiere optimierte RBF-SVR mit skalierten Zeittrends aus df_trends...")
svm_reg_extended.fit(X_train_re, y_train_re)

# 7. Auswertung
y_pred_re = svm_reg_extended.predict(X_test_re)
print("\n--- 📈 NEUE ERGEBNISSE: TIMETREND-REGRESSION (SVR) ---")
print(
    f"Mean Absolute Error (MAE): {mean_absolute_error(y_test_re, y_pred_re):.4f} (Tage/Zyklen)"
)
print(f"Bestimmtheitsmaß (R²-Score): {r2_score(y_test_re, y_pred_re):.4f}")


