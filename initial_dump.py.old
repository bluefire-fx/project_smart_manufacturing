# %% imports
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns
from sklearn.metrics import classification_report, confusion_matrix
from sklearn.model_selection import train_test_split
from sklearn.svm import SVC

# %% dataframe erstellen
df = pd.read_csv("data/raw/smart_manufacturing_data.csv")
df.head()

# %% spaltennamen des dataframes
df.columns.astype(str).to_list()
# %% Diskreptanz Statistik
df.describe()

# %% Gibt es irgendwelche fehlende Werte?
if df.isna().values.any():
    print("Ja")
else:
    print("Nein => Wir werden später welche fälschen müssen")


# %% maintenance_required
# 1. Get the frequency counts
counts = df["maintenance_required"].value_counts()
print(counts)

# 2. Create the figure and axis objects
fig, ax = plt.subplots(figsize=(6, 6))

# 3. Plot the pie chart on the 'ax' object
ax.pie(
    counts,
    labels=["0 (Mehrheit)", "1 (Minderheit)"],
    autopct="%1.1f%%",  # Shows the percentage (e.g., 80.0%)
    startangle=90,  # Rotates the chart for a cleaner look
    colors=["#ff9999", "#66b3ff"],  # Distinct colors
    wedgeprops={"edgecolor": "black"},  # Adds a clean border
)

# 4. Set titles and layout using the object-oriented style
ax.set_title(
    "Ungleiche Klassenverteilung!\n\n => Problem für das zukünftige SVM Modell\n => Stichproben als Lösungsansatz?",
    fontsize=14,
    pad=20,
)
fig.tight_layout()

# 5. Display the plot
plt.show()
# %% downtime_risk
# 1. Setup the figure and axis
fig, ax = plt.subplots(figsize=(10, 5))

# 2. Define custom bins to separate 0, the middle values, and 1
# This creates bins: [0.0 to 0.05), [0.05 to 0.95), [0.95 to 1.05]
custom_bins = [0.0, 0.05, 0.95, 1.05]

# 3. Plot the histogram
counts, bins, patches = ax.hist(
    df["downtime_risk"],
    bins=custom_bins,
    color="royalblue",
    edgecolor="black",
    rwidth=0.8,  # Adds a slight gap between bars for readability
)

# 4. Customize axes and labels
ax.set_title("Ausfallrisikoverteilung Histogramm", fontsize=14, pad=15)
ax.set_xlabel("Risikograd")
ax.set_ylabel("Anzahl der Zeilen (Logarithmisch)")

# CRUCIAL: Use a logarithmic scale because 90k vs 3 rows is impossible to see otherwise
ax.set_yscale("log")

# Set explicit X-ticks to match your data logic
ax.set_xticks([0.0, 0.5, 1.0])

# 5. Add text annotations above the bars to show the exact counts
for count, bin_edge in zip(counts, bins):
    if count > 0:
        # Place text slightly above the top of each bar
        ax.text(
            bin_edge + 0.02, count * 1.2, f"{int(count):,}", fontsize=10, weight="bold"
        )

fig.tight_layout()
plt.show()


