    "predicted_remaining_life",
    "anomaly_flag",
    "requires_maintenance",
]

# 2. Die Korrelationsmatrix berechnen
df_prep["requires_maintenance"] = (df["machine_status"] == 2).astype(int)
corr_matrix = df_prep[correlation_cols].corr()

