from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report

# 1. Wir nutzen exakt dieselben X_train und X_test Daten wie eben für die SVM!
# 2. Random Forest initialisieren (nutzt dank n_jobs=-1 übrigens ALLE deine CPU-Kerne parallel!)
rf_model = RandomForestClassifier(class_weight="balanced", n_jobs=-1, random_state=42)

print("Trainiere parallelen Random Forest Classifier...")
rf_model.fit(X_train, y_train)

# 3. Auswertung
y_pred_rf = rf_model.predict(X_test)
print("\n--- ERGEBNISSE: RANDOM FOREST ---")
